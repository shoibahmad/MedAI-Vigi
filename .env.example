# NVIDIA NIM (OpenAI-compatible endpoint) - required for AI narratives.
# Without a key the app still runs; every AI feature serves deterministic
# rule-based output instead.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# Tried when the primary model errors or is overloaded. Set empty to disable.
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b

# Reasoning models can emit a separate reasoning stream. Off by default: it is
# not wanted in clinical output and it costs latency.
NVIDIA_ENABLE_THINKING=false

# Flask
SECRET_KEY=change-me-in-production
FLASK_ENV=development

# Per-request timeout in seconds. Short on purpose so an overloaded primary
# model falls through to NVIDIA_FALLBACK_MODEL quickly.
NVIDIA_TIMEOUT=30

# Budget for the final model attempt, which must generate a full narrative.
NVIDIA_LONG_TIMEOUT=120
