# PhenoRx Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# API Keys (Required)
# ============================================================================

# Google Gemini API Key for AI report generation
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Separate API key for drug interactions (or use same as above)
GEMINI_API_KEY_DRUG_INTERACTIONS=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.0-flash-exp or gemini-1.5-pro)
GEMINI_MODEL_NAME=gemini-1.5-pro

# ============================================================================
# Server & Host Configuration
# ============================================================================

# Host binding interface (0.0.0.0 for containers, 127.0.0.1 for local dev)
HOST=0.0.0.0

# HTTP Port for Flask server
PORT=5000

# ============================================================================
# Observability & Error Tracking
# ============================================================================

# Sentry DSN for external error monitoring and APM traces (leave blank for local development)
SENTRY_DSN=

# ============================================================================
# Flask Configuration
# ============================================================================

# Application entry point
FLASK_APP=app.py

# Environment: development, production, testing
FLASK_ENV=development

# Debug mode: 1 for enabled, 0 for disabled
# WARNING: Never enable debug mode in production!
FLASK_DEBUG=1

# Server port (default: 5000)
FLASK_RUN_PORT=5000

# Server host (default: 127.0.0.1)
FLASK_RUN_HOST=127.0.0.1

# ============================================================================
# Security
# ============================================================================

# Secret key for session management (generate a strong random string)
# Example generation: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# ============================================================================
# Application Settings
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Model file paths (relative to project root)
MODEL_PATH=models/adr_model.pkl
PREPROCESSOR_PATH=models/adr_preprocessor.pkl

# Maximum number of concomitant drugs to analyze
MAX_DRUGS=10

# ============================================================================
# Optional: External Services
# ============================================================================

# Redis cache (if using caching)
# REDIS_URL=redis://localhost:6379/0

# Database URL (if implementing data persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/medai_vigi

# ============================================================================
# Optional: Feature Flags
# ============================================================================

# Enable/disable AI report generation
ENABLE_AI_REPORTS=true

# Enable/disable pharmacogenomics analysis
ENABLE_PHARMACOGENOMICS=true

# Enable/disable drug interaction checking
ENABLE_DRUG_INTERACTIONS=true

# ============================================================================
# Optional: Performance Tuning
# ============================================================================

# Number of Gunicorn workers (production)
WORKERS=4

# Request timeout in seconds
TIMEOUT=120

# ============================================================================
# Optional: Monitoring
# ============================================================================

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Enable metrics collection
ENABLE_METRICS=false

# ============================================================================
# Notes
# ============================================================================

# 1. Never commit the actual .env file to version control
# 2. Keep .env in your .gitignore file
# 3. Use strong, unique values for SECRET_KEY in production
# 4. Rotate API keys periodically for security
# 5. Use environment-specific .env files (.env.production, .env.development)
