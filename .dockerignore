# Keep the build context small and secrets out of the image.
# models/ and client/ are deliberately NOT excluded: the model is copied into the
# runtime stage, and client/ is the frontend build stage's input.

# Secrets - must never reach the image
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# Local virtualenvs and caches
myenv/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node - reinstalled from the lockfile inside the frontend stage
client/node_modules/
client/dist/
node_modules/

# Version control and CI
.git/
.github/
.gitignore
.gitattributes

# Not needed at runtime
tests/
scripts/
docs/
legacy/
reports/
mlruns/
notebooks/
data/
*.md
!README.md
Makefile
pytest.ini
dvc.yaml
docker-compose.yml
Procfile
render.yaml
.pre-commit-config.yaml
.flake8
.devcontainer/
.vscode/
package.json
package-lock.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
